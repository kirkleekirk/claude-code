<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless test harness.

    Everything below the renderer runs without a GraphicsDevice: terrain generation,
    lighting, meshing, physics, inventory, crafting and saving are all pure managed
    code. This project exercises that half directly, which is the only way to verify
    the engine on a machine that cannot run an Xbox 360 build.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>4</LangVersion>
    <AssemblyName>CastleMinerZ.Tests</AssemblyName>
    <RootNamespace>CastleMinerZ.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);MONOGAME;DESKTOP;HEADLESS_TESTS</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's own entry point is excluded so this project can define its own. -->
    <Compile Include="../src/**/*.cs" Exclude="../src/Program.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

</Project>
