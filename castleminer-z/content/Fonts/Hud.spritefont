<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD font.

  Kootenay ships with XNA Game Studio and is licensed for redistribution in games
  built with it, which is what makes it safe to bake into an Xbox 360 title. The
  content pipeline rasterises the glyph range below into a texture at build time,
  so the font does not need to exist on the console.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Kootenay</FontName>
    <Size>18</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
